rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coming-soon email signups (public write, no reads from the website)
    match /waitlist/{docId} {
      allow read: if false;
      allow create: if
        docId == request.resource.data.email
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
      allow update: if
        docId == request.resource.data.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
      allow delete: if false;
    }
  }
}
